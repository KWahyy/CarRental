{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "kdsexotics.com"
        }
      ],
      "destination": "https://www.prestigeluxor.com",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.kdsexotics.com"
        }
      ],
      "destination": "https://www.prestigeluxor.com",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kdsexotics.com"
        }
      ],
      "destination": "https://www.prestigeluxor.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kdsexotics.com"
        }
      ],
      "destination": "https://www.prestigeluxor.com/:path*",
      "permanent": true
    },
    {
      "source": "/cars/porschepanamera",
      "destination": "/cars/porsche-panamera",
      "permanent": true
    },
    {
      "source": "/wedding-car-rental",
      "destination": "/wedding",
      "permanent": true
    }
  ]
}
